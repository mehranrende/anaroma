<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_anaroma_formula" model="ir.sequence">
            <field name="name">Anaroma Formül</field>
            <field name="code">anaroma.formula</field>
            <field name="prefix">FRM-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Ithal hammaddeler icin doviz -->
        <record id="base.USD" model="res.currency">
            <field name="active" eval="True"/>
        </record>
        <record id="base.EUR" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <!-- Ornek ambalaj birimleri: Yapilandirma > Birimler'den degistirilebilir -->
        <record id="uom_drum_25kg" model="uom.uom">
            <field name="name">Bidon (25 kg)</field>
            <field name="relative_uom_id" ref="uom.product_uom_kgm"/>
            <field name="relative_factor">25</field>
        </record>
        <record id="uom_drum_200kg" model="uom.uom">
            <field name="name">Varil (200 kg)</field>
            <field name="relative_uom_id" ref="uom.product_uom_kgm"/>
            <field name="relative_factor">200</field>
        </record>
    </data>

    <!-- Birim ve coklu para birimi alanlari tum kullanicilara gorunsun -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('uom.group_uom'))]"/>
    </record>
</odoo>
