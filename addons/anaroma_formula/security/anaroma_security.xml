<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formuller ticari sirdir: sadece bu gruplardaki kullanicilar gorebilir. -->
    <record id="res_groups_privilege_formula" model="res.groups.privilege">
        <field name="name">Formülasyon</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_formula_user" model="res.groups">
        <field name="name">Kullanıcı (formülleri görüntüler)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_formula"/>
    </record>

    <record id="group_formula_manager" model="res.groups">
        <field name="name">Yönetici (formül yazar ve onaylar)</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_formula"/>
        <field name="implied_ids" eval="[Command.link(ref('group_formula_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rule_formula_company" model="ir.rule">
        <field name="name">Formül: şirket kuralı</field>
        <field name="model_id" ref="model_anaroma_formula"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_formula_line_company" model="ir.rule">
        <field name="name">Formül satırı: şirket kuralı</field>
        <field name="model_id" ref="model_anaroma_formula_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
