<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_anaroma_formula_form" model="ir.ui.view">
        <field name="name">anaroma.formula.form</field>
        <field name="model">anaroma.formula</field>
        <field name="arch" type="xml">
            <form string="Formül">
                <header>
                    <button name="action_approve" type="object" string="Onayla" class="btn-primary"
                            invisible="state != 'draft'" groups="anaroma_formula.group_formula_manager"
                            confirm="Formül onaylanacak, önceki onaylı versiyon 'Eski' olacak ve üretim reçetesi güncellenecek. Devam edilsin mi?"/>
                    <button name="action_new_version" type="object" string="Yeni Versiyon"
                            invisible="state == 'draft'" groups="anaroma_formula.group_formula_manager"/>
                    <button name="action_update_product_cost" type="object" string="Ürün Maliyetini Güncelle"
                            invisible="state != 'approved'" groups="anaroma_formula.group_formula_manager"/>
                    <button name="action_set_draft" type="object" string="Taslağa Al"
                            invisible="state != 'approved'" groups="anaroma_formula.group_formula_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,obsolete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bom" type="object" class="oe_stat_button" icon="fa-flask"
                                invisible="not bom_id">
                            <span>Üretim Reçetesi</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Eski" bg_color="text-bg-secondary" invisible="state != 'obsolete'"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="code" readonly="1"/></div>
                        <h1><field name="name" placeholder="Formül adı"/></h1>
                    </div>
                    <group>
                        <group string="Ürün">
                            <field name="product_tmpl_id" readonly="state != 'draft'"
                                   context="{'default_anaroma_kind': 'essence'}"/>
                            <field name="product_kind"/>
                            <field name="version"/>
                            <field name="batch_size" readonly="state != 'draft'"/>
                            <field name="cost_method"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="previous_formula_id" invisible="not previous_formula_id"/>
                        </group>
                        <group string="Maliyet">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_weight"/>
                            <field name="cost_total" widget="monetary"/>
                            <field name="cost_per_kg" widget="monetary" class="fw-bold"/>
                            <field name="batch_cost" widget="monetary"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                        </group>
                    </group>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not cost_warning">
                        Bazı satırlarda maliyet uyarısı var (fiyat yok, birim çevrilemiyor veya minimum alım miktarının altında). Satırlardaki "Uyarı" sütununa bakın.
                    </div>
                    <notebook>
                        <page string="Hammaddeler" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_tmpl_id" column_invisible="1"/>
                                    <field name="product_id" context="{'default_anaroma_kind': 'raw'}"/>
                                    <field name="cas_number" optional="hide"/>
                                    <field name="weight" sum="Toplam"/>
                                    <field name="percentage" sum="Toplam"/>
                                    <field name="qty_kg" optional="show"/>
                                    <field name="supplierinfo_id" optional="hide" options="{'no_create': True}"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="country_id" optional="show"/>
                                    <field name="price_info" optional="show"/>
                                    <field name="cost_source" optional="hide"/>
                                    <field name="unit_cost" widget="monetary"/>
                                    <field name="line_cost" widget="monetary" sum="Toplam"/>
                                    <field name="cost_share" optional="show"/>
                                    <field name="warning" decoration-warning="warning" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notlar" name="notes">
                            <field name="notes" placeholder="Koku notaları, üretim talimatları, dikkat edilecekler..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_anaroma_formula_list" model="ir.ui.view">
        <field name="name">anaroma.formula.list</field>
        <field name="model">anaroma.formula</field>
        <field name="arch" type="xml">
            <list string="Formüller" decoration-muted="state == 'obsolete'">
                <field name="code"/>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_kind"/>
                <field name="version"/>
                <field name="total_weight" optional="show"/>
                <field name="batch_size" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cost_per_kg" widget="monetary"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_anaroma_formula_search" model="ir.ui.view">
        <field name="name">anaroma.formula.search</field>
        <field name="model">anaroma.formula</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('product_tmpl_id', 'ilike', self)]"/>
                <field name="product_tmpl_id"/>
                <field name="line_ids" string="Hammadde" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="draft" string="Taslak" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Onaylı" domain="[('state', '=', 'approved')]"/>
                <filter name="obsolete" string="Eski" domain="[('state', '=', 'obsolete')]"/>
                <separator/>
                <filter name="aroma" string="Aroma" domain="[('product_kind', '=', 'aroma')]"/>
                <filter name="essence" string="Esans" domain="[('product_kind', '=', 'essence')]"/>
                <group>
                    <filter name="group_product" string="Ürün" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_state" string="Durum" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_anaroma_formula" model="ir.actions.act_window">
        <field name="name">Formüller</field>
        <field name="res_model">anaroma.formula</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_approved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">İlk formülünüzü oluşturun</p>
            <p>Bir aroma veya esans seçin, hammaddeleri gram cinsinden ekleyin.
               Maliyet tedarikçi fiyatlarından otomatik hesaplanır.</p>
        </field>
    </record>
</odoo>
